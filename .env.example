# Org LiteLLM proxy (OpenAI-compatible). /v1 is appended automatically if omitted.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_KEY=

# LiteLLM model aliases (do not point at vLLM ports directly)
BRAIN_MODEL=agent-brain
DOMAIN_FT_MODEL=domain-ft

# API shape for domain-ft calls: chat (default) | completion
DOMAIN_PREDICT_MODE=chat

MAX_AGENT_STEPS=5
# Optional: APP_CONFIG=/absolute/path/to/config.yaml
